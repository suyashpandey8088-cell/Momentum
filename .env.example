# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Internal server-side proxy target used by Next.js rewrites.
API_INTERNAL_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/momentum.db
REDIS_URL=
COOKIE_SECURE=false
ENCRYPTION_KEY=
EMBEDDED_WORKER=true
ENABLE_DEMO=true
UPLOAD_DIR=./data/private
MAX_UPLOAD_MB=250
WORKER_INTERVAL_SECONDS=5
DEMO_EMAIL_DOMAIN=demo.momentum.local

# PostgreSQL production example (Supabase or self-hosted):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Optional: durable private object storage. Local disk is used when unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=momentum-recordings

# Optional AI providers. Without keys, labeled local extraction and lexical retrieval work.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional SMTP. Without SMTP, email notifications remain in the private outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MOMENTUM <hello@example.com>
SMTP_TLS=true

# Google sign-in (OIDC). Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integration OAuth apps. Redirect URI pattern: {API_URL}/api/integrations/{provider}/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=
